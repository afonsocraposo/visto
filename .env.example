# TMDB API access (needed for media search and metadata)
VISTO_TMDB_API_KEY=replace_with_your_tmdb_api_key

# Optional server and account settings. Defaults are shown in comments.
# Docker Compose image version. Pin to a release such as 0.3.0 for stable deployments.
# VISTO_VERSION=latest
# VISTO_LISTEN_ADDR=:8080
# VISTO_DATABASE_PATH=  # Local default: ./data/visto.db; Compose default: /data/visto.db
# VISTO_PUBLIC_URL=
# VISTO_TRUSTED_PROXY_CIDRS=
# VISTO_ALLOW_SIGNUPS=true
# Optional path to built frontend files. Leave unset during Vite development.
# VISTO_WEB_DIR=

# Optional Google sign-in. Set all three values to enable it.
# VISTO_GOOGLE_CLIENT_ID=
# VISTO_GOOGLE_CLIENT_SECRET=
# VISTO_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# SQLite backup defaults.
# VISTO_BACKUP_DIR=  # Defaults to a directory beside the database.
# VISTO_BACKUP_INTERVAL=24h
# VISTO_BACKUP_RETENTION=720h

# Background refresh defaults. Durations use Go syntax, such as 30m or 12h.
# VISTO_CATALOG_REFRESH_INTERVAL=6h
# VISTO_CATALOG_ACTIVE_TTL=24h
# VISTO_CATALOG_FINISHED_TTL=720h
# VISTO_OAUTH_CLEANUP_INTERVAL=24h
# VISTO_ACTIVITY_CLEANUP_INTERVAL=24h
# VISTO_ACTIVITY_RETENTION=8760h  # One year; removes activity feed events, not watch history.

# Optional encrypted storage and per-user Pushover notification checks.
# Generate the encryption key with: openssl rand -base64 32
# VISTO_SECRET_ENCRYPTION_KEY=
# VISTO_PUSHOVER_INTERVAL=15m
