{
  "name": "visto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "db:diagram": "node ./scripts/generate-db-diagram.mjs",
    "db:studio": "drizzle-kit studio --config=./drizzle.config.ts --host=127.0.0.1",
    "generate:api": "orval --config ./orval.config.ts",
    "preview": "vite preview",
    "format": "prettier --write . && prettier --write public/icon.svg --parser html",
    "format:check": "prettier --check . && prettier --check public/icon.svg --parser html",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/form": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "orval": "8.37.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
